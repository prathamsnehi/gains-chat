{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".yarn/cache",
        ".yarn/unplugged",
        ".yarn/install-state.gz",
        ".yarn/build-state.yml",
        "**/*.test.js",
        "scripts",
        "audit-*.jsonl",
        "*.log"
      ],
      "runtime": "nodejs24"
    }
  ]
}
