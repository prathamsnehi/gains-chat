{
  "functions": [
    {
      "source": "hosting/functions",
      "codebase": "default",
      "runtime": "nodejs24",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "**/*.test.js"
      ]
    }
  ],
  "hosting": {
    "public": "hosting/public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/chat",
        "function": {
          "functionId": "chat",
          "region": "us-central1"
        }
      }
    ]
  }
}
