{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test ai/*.test.js",
    "check:firestore": "node scripts/validateFirestoreConfig.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^1.5.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^14.11.2"
  },
  "private": true,
  "overrides": {
    "router": {
      "path-to-regexp": "^8.4.2"
    }
  }
}
