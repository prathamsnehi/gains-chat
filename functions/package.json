{
  "name": "functions",
  "packageManager": "yarn@4.18.1",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "yarn shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test ai/*.test.js",
    "check:firestore": "node scripts/validateFirestoreConfig.js",
    "audit": "yarn npm audit --all --recursive",
    "audit:production": "yarn npm audit --all --recursive --environment production",
    "test:firestore": "node scripts/runFirestoreCheck.cjs"
  },
  "engines": {
    "node": "24",
    "yarn": "4.18.1"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "5.0.5",
    "@google/genai": "2.30.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "firebase-tools": "15.34.0"
  },
  "private": true,
  "resolutions": {
    "cloudevents/uuid": "11.1.1",
    "gaxios/uuid": "11.1.1"
  }
}
